# Copy to .env.local (never commit .env.local)

# Express API (fixmate-server)
NEXT_PUBLIC_API_URL=http://localhost:5000

# ImgBB image upload (https://api.imgbb.com/)
NEXT_PUBLIC_IMGBB_API_KEY=your_imgbb_key

# BetterAuth + MongoDB (same database as the server)
BETTER_AUTH_SECRET=your_better_auth_secret
BETTER_AUTH_URL=http://localhost:3000
MONGODB_URI=your_mongodb_uri
DB_NAME=fixmate

# Must be identical to JWT_SECRET in the server's .env
JWT_SECRET=your_jwt_secret

# Optional: extra trusted origins (comma separated), e.g. your production domain
EXTRA_TRUSTED_ORIGINS=

# Optional: Google social login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
